{
  "entities": {
    "Attendee": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Attendee",
      "type": "object",
      "description": "Represents an attendee participating in the seminar.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The full name of the attendee."
        },
        "affiliation": {
          "type": "string",
          "description": "The attendee's affiliation (e.g., company, university)."
        },
        "creatorId": {
          "type": "string",
          "description": "The Firebase UID of the user who created the entry."
        }
      },
      "required": [
        "name",
        "affiliation",
        "creatorId"
      ]
    },
    "Question": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Question",
      "type": "object",
      "description": "A question submitted by an attendee.",
      "properties": {
        "text": {
          "type": "string",
          "description": "The content of the question."
        },
        "creatorId": {
          "type": "string",
          "description": "The Firebase UID of the user who submitted the question."
        }
      },
      "required": [
        "text",
        "creatorId"
      ]
    }
  },
  "auth": {
    "providers": [
      "anonymous"
    ]
  },
  "firestore": {
    "/attendees/{attendeeId}": {
      "schema": {
        "$ref": "#/entities/Attendee"
      },
      "description": "Stores information about each seminar attendee."
    },
    "/questions/{questionId}": {
      "schema": {
        "$ref": "#/entities/Question"
      },
      "description": "Stores questions submitted by attendees."
    }
  }
}
