/**
 * This ruleset enforces a security model for the SeminarSync application.
 *
 * Core Philosophy:
 * The security model prioritizes Authorization Independence, meaning that authorization
 * decisions for a document are made using data on that document itself, avoiding
 * slow and costly `get()` calls to other documents. All access is restricted to
 * authenticated users, which includes users signed in anonymously. User-generated
 * content, like questions and attendee registrations, follows a strict ownership
 * model where only the creator can add their own content.
 *
 * Data Structure:
 * The data is organized into several flat, top-level collections:
 * - /attendees: Stores a list of seminar participants.
 * - /presentation_orders: Stores the schedule and order of presentations.
 * - /presentation_materials: Contains links to presentation slides and materials.
 * - /questions: A collection of questions submitted by attendees for presenters.
 *
 * Key Security Decisions:
 * - Authenticated Access Only: All read and write operations across the database
 *   require the user to be authenticated, even if anonymously. This prevents
 *   unauthenticated data scraping or submission.
 * - Public Read, Owner-Only Create: Collections like `/attendees` and `/questions`
 *   are readable by all authenticated users, but writes are strictly limited to the
 *   document's owner to prevent data tampering.
 * - Read-Only Reference Data: Collections like `/presentation_orders` and
 *   `/presentation_materials` are treated as read-only for clients, assuming they
 *   are managed by a trusted backend process or administrator.
 *
 * Denormalization for Authorization:
 * To enable fast and secure rules, an ownership model is enforced on user-generated
 * content. For example, each document in `/attendees` and `/questions` is expected
 * to have a `creatorId` field containing the UID of the user who submitted it. This
 * allows rules to grant permissions by simply checking this field against the
 * requestor's UID, without needing to read any other documents.
 *
 * Structural Segregation:
 * The use of separate top-level collections for different data types provides a
 * clear and secure separation of concerns, making it simple to apply different
 * security postures to each data type.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------
    // Helper Functions
    // --------------------------------

    /**
     * Checks if the user is signed in (including anonymous users).
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the currently authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks for ownership on an existing document. Used for update and delete.
     * Prevents operations on documents that do not exist.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Ensures a document's creatorId field cannot be changed after creation.
     */
    function isCreatorIdUnchanged() {
      return request.resource.data.creatorId == resource.data.creatorId;
    }

    // --------------------------------
    // Collection Rules
    // --------------------------------

    /**
     * @description Manages the list of seminar attendees.
     * @path /attendees/{attendeeId}
     * @allow (get, list) Any authenticated user can read the list of attendees.
     * @allow (create) An authenticated user can add a new attendee document if they are the creator.
     * @deny (update, delete) No user can modify or delete attendee information after creation.
     * @principle Enforces an ownership model for creating data, while making the list publicly readable to other authenticated users.
     */
    match /attendees/{attendeeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if false;
    }

    /**
     * @description Manages the presentation schedule, treated as read-only reference data.
     * @path /presentation_orders/{presentationId}
     * @allow (get) An authenticated user reads the presentation schedule.
     * @deny (create, update, delete) Any user attempts to modify the schedule.
     * @principle Protects critical reference data by making it read-only from the client side.
     */
    match /presentation_orders/{presentationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages presentation materials, treated as read-only reference data.
     * @path /presentation_materials/{materialId}
     * @allow (get) An authenticated user reads a link to a presentation file.
     * @deny (create, update, delete) Any user attempts to modify the presentation materials.
     * @principle Protects critical reference data by making it read-only from the client side.
     */
    match /presentation_materials/{materialId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Manages questions submitted by attendees during the seminar.
     * @path /questions/{questionId}
     * @allow (create) An authenticated user `(uid: 'user123')` creates a question with `{ creatorId: 'user123' }`.
     * @deny (update) A user `(uid: 'user456')` tries to update a question created by `'user123'`.
     * @principle Enforces document ownership for writes. Any authenticated user can read all questions and create new ones, but only the original author can modify or delete their own question.
     */
    match /questions/{questionId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.creatorId) && isCreatorIdUnchanged();
      allow delete: if isExistingOwner(resource.data.creatorId);
    }
  }
}
